{
  "version": "2.0.0",
  "cwd": "${workspaceFolder}",
  "tasks": [
    {
      "label": "run server",
      "command": "templ",
      "args": [
        "generate",
        "--watch",
        "--cmd",
        "go run cmd/main.go serve --http 0.0.0.0:8099"
      ],
      "group": "build",
      "type": "shell",
      "isBackground": true,
      "options": {
        "env": {}
      }
    },
    {
      "label": "run nats-server",
      "command": "nats-server",
      "args": [
        "-c",
        "nats-server.conf"
      ],
      "group": "build",
      "type": "shell",
      "isBackground": true,
      "options": {
        "env": {}
      }
    },
    {
      "label": "run frontend",
      "command": "pnpm",
      "args": [
        "dev"
      ],
      "group": "build",
      "type": "shell",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/frontend",
        "env": {}
      }
    },
    {
      "label": "run dev environment",
      "dependsOn": [
        "run server",
        "run nats-server",
        "run frontend"
      ],
      "problemMatcher": []
    }
  ]
}
